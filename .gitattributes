# Automatically detect text files and store consistent line endings in Git.
* text=auto

# Source code and configuration files use LF across Windows, Linux, and macOS.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.mako text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf

# Windows command scripts should use Windows-compatible CRLF endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files must never undergo line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary