# IntraCore backend application identity.
APP_NAME=IntraCore AI API
APP_VERSION=0.1.0

# Local Ollama runtime endpoint.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Temporary development chat model.
# This is configurable and must not be treated as the permanent product model.
OLLAMA_CHAT_MODEL=deepseek-r1:1.5b

# Reasoning handling for compatible chat models:
# auto = do not force a reasoning option
# enabled = request separated reasoning metadata (never exposed to clients)
# disabled = request normal non-reasoning generation
OLLAMA_REASONING_MODE=auto

# Local embedding model reserved for future document retrieval features.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Local asynchronous SQLite database.
DATABASE_URL=sqlite+aiosqlite:///./data/intracore.db

# Local Next.js frontend allowed to call the FastAPI backend.
FRONTEND_ORIGIN=http://localhost:3000
